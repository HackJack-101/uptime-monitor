# Copy to .env for docker compose / local development. Never commit the real .env.
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PUBLIC_URL=https://status.example.com
TRUST_PROXY=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Uptime Monitor <monitor@example.com>"
RETENTION_DAYS=30
